# ==============================================================================
# Kaspi to WhatsApp Community & Social Media Pipeline Configuration
# Скопируйте этот файл в .env и укажите ваши параметры
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Копирайтинг (Google Gemini API)
# Получить ключ бесплатно: https://aistudio.google.com/app/apikey
# Если ключ не указан, генератор использует встроенные шаблоны
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. Локальный мост WhatsApp (Baileys Node.js шлюз)
# ------------------------------------------------------------------------------
WA_BRIDGE_HOST=127.0.0.1
WA_BRIDGE_PORT=3000

# ------------------------------------------------------------------------------
# 3. WhatsApp Сообщество и каналы объявлений (формат: 120363xxxxxx@g.us)
# Чтобы узнать все ID, запустите: python main.py list-chats
# ------------------------------------------------------------------------------
# ID родительского сообщества и главного канала объявлений
WA_COMMUNITY_ID=
WA_COMMUNITY_ANNOUNCEMENT=

# Чат по умолчанию (куда отправлять, если для ниши не задан свой чат)
WA_CHAT_DEFAULT=

# Индивидуальные подгруппы объявлений для 6 ниш сообщества:
WA_CHAT_MEN_CLOTHING=
WA_CHAT_GADGETS=
WA_CHAT_KITCHEN=
WA_CHAT_CARE=
WA_CHAT_AUTO=
WA_CHAT_SPORT=

# ------------------------------------------------------------------------------
# 4. Фильтрация и критерии отбора находок с Kaspi
# ------------------------------------------------------------------------------
# ID города Kaspi (750000000 = Алматы, максимальный ассортимент)
KASPI_CITY_ID=750000000

# Минимальный рейтинг товара (от 1.0 до 5.0)
MIN_RATING=4.7

# Минимальное количество отзывов реальных покупателей
MIN_REVIEWS=15

# ------------------------------------------------------------------------------
# 5. Синхронизация с Google Таблицами (Google Apps Script Webhook)
# Подробная инструкция по развертыванию скрипта: SHEETS_API_INSTRUCTIONS.md
# ------------------------------------------------------------------------------
GOOGLE_SHEETS_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 6. Экспорт слайдов в Google Диск (для TikTok / Reels)
# Укажите путь к папке Google Drive for Desktop или оставьте пустым
# для сохранения в локальную папку ./Google_Drive/
# Пример: G:\Мой диск\Kaspi_Находки
# ------------------------------------------------------------------------------
GOOGLE_DRIVE_PATH=
